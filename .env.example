# ============================================================
# VoiceShield — Environment Variables Template
# voiceshield-team/voiceshield-sih-2026
# DO NOT commit .env or .env.local — this file is safe to commit
# ============================================================

# ─────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=VoiceShield
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────
# FRONTEND → SUPABASE (safe for browser)
# ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY

# ─────────────────────────────────────────
# FRONTEND → FASTAPI BACKEND
# ─────────────────────────────────────────
NEXT_PUBLIC_FASTAPI_HTTP_URL=http://localhost:8000
NEXT_PUBLIC_FASTAPI_WS_URL=ws://localhost:8000/ws/audio

# ─────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────
NEXT_PUBLIC_ENABLE_LIVE_DEMO=true
NEXT_PUBLIC_ENABLE_CHALLENGE_RESPONSE=true
NEXT_PUBLIC_ENABLE_FALLBACK_MODE=true
NEXT_PUBLIC_DEFAULT_LANGUAGE=en

# ─────────────────────────────────────────
# BACKEND → SUPABASE (NEVER expose to browser)
# ─────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
SUPABASE_STORAGE_BUCKET=challenge-audio

# ─────────────────────────────────────────
# ML MODEL
# ─────────────────────────────────────────
MODEL_NAME=aasist
MODEL_VERSION=0.1.0
MODEL_PATH=./models/aasist.pt
DEVICE=cpu
ENABLE_FP16=false

# ─────────────────────────────────────────
# AUDIO STREAMING
# ─────────────────────────────────────────
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_MS=333
AUDIO_RING_BUFFER_SECONDS=4

# ─────────────────────────────────────────
# WEBSOCKET RESILIENCE
# ─────────────────────────────────────────
WS_RECONNECT_BASE_DELAY_MS=1000
WS_RECONNECT_MAX_DELAY_MS=30000
WS_RECONNECT_MULTIPLIER=2
WS_RECONNECT_JITTER=0.2
WS_RECONNECT_MAX_ATTEMPTS=10
WS_HEARTBEAT_SECONDS=20
WS_MAX_CONNECTIONS=100

# ─────────────────────────────────────────
# PRIVACY & AUDIT
# ─────────────────────────────────────────
ENABLE_AUDIT_LOGGING=true
STORE_RAW_AUDIO=false

# ─────────────────────────────────────────
# BACKEND SERVICE
# ─────────────────────────────────────────
APP_NAME=VoiceShield API
APP_ENV=development
PORT=8000
LOG_LEVEL=info
