# VoiceShield Configuration
# Updated: September 2026
# DO NOT commit actual secrets.

# --- Frontend Application ---
NEXT_PUBLIC_APP_NAME="VoiceShield"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Backend API (FastAPI host — not Vercel) ---
NEXT_PUBLIC_FASTAPI_HTTP_URL=http://localhost:8000
NEXT_PUBLIC_FASTAPI_WS_URL=ws://localhost:8000/ws/audio

# --- Twilio Alerts (Backend only) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=
ALERT_PHONE_NUMBER=

# --- Feature Flags ---
NEXT_PUBLIC_ENABLE_LIVE_DEMO=true
NEXT_PUBLIC_ENABLE_CHALLENGE_RESPONSE=true
NEXT_PUBLIC_ENABLE_FALLBACK_MODE=true

# --- AI assistant (server-only; never NEXT_PUBLIC_) ---
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# --- Transcription abstraction (async path) ---
# mock | deepgram | whisper
TRANSCRIPTION_PROVIDER=mock
DEEPGRAM_API_KEY=
WHISPER_ENDPOINT=
OPENAI_API_KEY=

# --- THROUGHPUTS gateway (async analysis — NOT the real-time detector) ---
# mock | throughputs
ANALYSIS_PROVIDER=mock
THROUGHPUTS_BASE_URL=
THROUGHPUTS_API_KEY=
# Set only after provider catalogue verification — do not invent model IDs
THROUGHPUTS_MODEL=
