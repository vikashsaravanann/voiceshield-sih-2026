# VoiceShield Configuration
# Updated: September 2026
# Note: Keep this file in sync with Vercel environment variables!
# DO NOT commit actual secrets here.

# --- Frontend Application ---
NEXT_PUBLIC_APP_NAME="VoiceShield SIH26104"
NEXT_PUBLIC_APP_ENV="development"

# --- Supabase ---
# Grab these from: Project Settings > API
# The URL looks something like https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Backend API ---
# If you are running the FastAPI backend locally, use these.
# Update these after deploying to Render/HuggingFace!
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# --- Twilio Alerts (Backend only) ---
# Used for sending WhatsApp threat alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=
ALERT_PHONE_NUMBER= # The phone number that receives the alerts

# --- Feature Flags ---
# TODO: actually wire these up in the UI soon
NEXT_PUBLIC_ENABLE_LIVE_DEMO=true
NEXT_PUBLIC_ENABLE_CHALLENGE_RESPONSE=false 
